{
  "name": "sea-train",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "realtime": "node server.js",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test --config browser.config.js",
    "start": "node server.js",
    "check:clean": "node scripts/clean-install.mjs",
    "verify": "npm run build && npm test && npm run test:e2e && npm run test:release",
    "format": "prettier --write src server.js server scripts",
    "format:check": "prettier --check src server.js server scripts",
    "test:release": "playwright test --config release-browser.config.js"
  },
  "dependencies": {
    "three": "0.180.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "prettier": "3.6.2",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT"
}
